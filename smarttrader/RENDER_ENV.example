# Set these in Render Environment. Never commit actual credentials.
CAP_ENV=demo
CAP_API_KEY=
CAP_IDENTIFIER=
CAP_API_PASSWORD=
BOT_ACCOUNT_ID=330438437114294558
BOT_STATE_PATH=/var/data/demo.sqlite
SMART_STATE_DIR=/var/data/smarttrader
SMART_MODE=preview
SMART_MARKETS=broad
SMART_DAILY_RISK_MODE=auto
# Optional legacy fixed mode: SMART_DAILY_RISK_MODE=fixed, SMART_DAILY_LOSS_LIMIT=<USD>
SMART_AI_CALLS_PER_DAY=4
# Existing 4/day remains a shared limit, not 4 per market. Optional 24/day
# gives at most one new analysis per hour, still sharing the persistent budget.
SMART_NEWS_SYMBOLS={"EURUSD":"EURUSD.FOREX"}
# SMART_NEWS_SYMBOLS is used only when SMART_MARKETS=single.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
EODHD_API_KEY=
# Only after successful preview, verified account is flat and old worker stopped:
# SMART_MODE=demo
# SMART_ARMED=DEMO_ONLY
# SMART_EXCLUSIVE_ACCOUNT=330438437114294558
